{
  "name": "my-node-cli",
  "version": "1.0.0",
  "description": "A simple CLI tool to display date and time",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "my-node-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm test && npm run build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf dist",
    "dev": "tsc --watch"
  },
  "keywords": [
    "cli",
    "date",
    "time"
  ],
  "author": "helloca",
  "license": "ISC",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.40.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
