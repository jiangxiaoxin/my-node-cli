{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug my-node-cli (无参数)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "stopOnEntry": true,
            "program": "${workspaceFolder}/dist/index.js",
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "args": [],
            "env": {
                "NODE_ENV": "development"
            },
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug my-node-cli (带参数)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "stopOnEntry": true,
            "program": "${workspaceFolder}/dist/index.js",
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "args": ["--date"],
            "env": {
                "NODE_ENV": "development"
            },
            "sourceMaps": true
        }
    ]
} 